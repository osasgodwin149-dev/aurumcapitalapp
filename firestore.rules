rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    function isValidUser(data) {
      return data.keys().hasAll(['username', 'password', 'joinedAt', 'balance', 'hasClaimed']) &&
             data.keys().hasOnly(['username', 'password', 'joinedAt', 'balance', 'hasClaimed', 'pinStatus', 'transactionPin']) &&
             data.username is string && data.username.size() >= 1 && data.username.size() <= 64 &&
             data.password is string && data.password.size() >= 1 && data.password.size() <= 128 &&
             data.joinedAt is string && data.joinedAt.size() <= 64 &&
             (data.balance is int || data.balance is float) && data.balance >= 0 &&
             data.hasClaimed is bool &&
             (!('pinStatus' in data) || (data.pinStatus is string && data.pinStatus.size() <= 20)) &&
             (!('transactionPin' in data) || (data.transactionPin is string && data.transactionPin.size() <= 10));
    }

    match /users/{username} {
      allow get: if isValidId(username);
      allow list: if true;
      allow create: if isValidId(username) &&
                       isValidUser(request.resource.data) &&
                       request.resource.data.username == username &&
                       request.resource.data.balance >= 0;
      allow update: if isValidId(username) &&
                       isValidUser(request.resource.data) &&
                       request.resource.data.username == resource.data.username &&
                       (
                         // Action 1: Citizen Claiming 1 Trillion Naira (once only)
                         (resource.data.hasClaimed == false &&
                          request.resource.data.hasClaimed == true &&
                          request.resource.data.balance == 1000000000000 &&
                          request.resource.data.password == resource.data.password &&
                          request.resource.data.joinedAt == resource.data.joinedAt &&
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance', 'hasClaimed'])) ||
                         // Action 2: PIN update, Admin or balance/credential update
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance', 'hasClaimed', 'password', 'pinStatus', 'transactionPin'])
                       );
      allow delete: if isValidId(username) && username != 'admin';
    }
  }
}
